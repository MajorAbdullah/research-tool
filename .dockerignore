# =============================================================================
# .dockerignore — keep the build context (and therefore the image) small and
# secret-free. Mirrors .gitignore for anything that must never end up in a
# layer, plus repo content the image never needs at runtime.
# =============================================================================

# --- never send secrets to the build context, even transiently ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- deps: reinstalled fresh in the builder stages ---
node_modules/
**/node_modules/
.pnpm-store/

# --- build output: regenerated by `pnpm run build` inside the image ---
.next/
out/
next-env.d.ts
extension/dist/
*.tsbuildinfo

# --- the SQLite data dir is bind-mounted at runtime, never baked into the image ---
data/
*.db
*.db-wal
*.db-shm

# --- local embedding model cache: bind-mounted or downloaded at runtime, not baked in ---
.fastembed_cache/
models/

# --- test/coverage output, not needed to build or run the app ---
coverage/
playwright-report/
test-results/

# --- VCS / editor / OS cruft ---
.git/
.github/
.gitignore
.gitleaks.toml
.husky/
.vscode/
.idea/
.DS_Store
*.swp

# --- docs and non-runtime project files: irrelevant to the built artifact ---
docs/
Best Practices/
deploy/
*.md
LICENSE

# --- CI/deploy tooling lives outside the image ---
compose.yml
compose.prod.yml
Dockerfile
.dockerignore
