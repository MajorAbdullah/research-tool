{
  "name": "sieve",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted AI research library — share a link, get it extracted, enriched, grouped and searchable",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3060",
    "build": "next build",
    "start": "next start -p 3060",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed:user": "tsx src/db/seed-user.ts",
    "reembed": "tsx src/lib/embeddings/reembed.ts",
    "eval": "vitest run --config vitest.eval.config.mts eval/retrieval",
    "eval:rag": "vitest run --config vitest.eval.config.mts eval/generation",
    "build:ext": "pnpm --filter sieve-extension build",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit src"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-auth": "5.0.0-beta.32",
    "drizzle-orm": "0.45.2",
    "better-sqlite3": "13.0.3",
    "sqlite-vec": "0.1.9",
    "fastembed": "2.1.0",
    "onnxruntime-node": "1.29.0",
    "argon2": "0.45.1",
    "zod": "4.6.2",
    "@tanstack/react-query": "5.102.8",
    "pino": "10.3.1",
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.0.1",
    "undici": "8.10.2",
    "pdf-parse": "2.4.5",
    "lucide-react": "1.45.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "30.0.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-kit": "0.31.10",
    "vitest": "5.0.0",
    "@playwright/test": "1.63.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "argon2",
      "onnxruntime-node",
      "sqlite-vec",
      "esbuild"
    ]
  }
}
