# =============================================================================
# Sieve — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in real values:
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file (with
# placeholders only) is the thing that IS committed — see CLAUDE.md's
# "Secrets" non-negotiable. If you're about to `git add .env`, stop.
#
# Every variable below is read once at boot through a Zod-validated config
# loader (P1.2.6): a missing required value fails startup immediately with a
# readable error, rather than the app coming up half-broken. See docs/API.md
# for how EXTENSION_TOKEN, the LLM chains, and the budget vars show up on the
# wire.
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Cosmetic display name — shown in the UI header, the PWA manifest, and any
# future notification copy. Doesn't affect behavior.
APP_NAME=Sieve

# Canonical public URL Sieve is served at (no trailing slash). Used to build
# every absolute link the app needs to generate itself: the PWA manifest's
# start_url and share_target, Auth.js's callback/redirect URLs, and the
# WebAuthn/passkey relying-party origin. There is deliberately no separate
# AUTH_URL or RP-ID variable — this one value feeds all of them.
#   Local dev:  http://localhost:3060
#   Production: https://sieve.teknikki.com
APP_URL=http://localhost:3060

# TCP port the Next.js server listens on inside the container. Production's
# host nginx vhost proxies 127.0.0.1:3060 -> this port (see deploy/) and this
# port is also what's free on the VPS (see the plan's §3 port survey) — if
# you change it, update the nginx vhost and docker-compose port mapping in
# the same commit, not separately.
PORT=3060


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Filesystem path to the SQLite database file (WAL mode, sqlite-vec + FTS5
# loaded from the same connection). Point this at a path under a bind-mounted
# volume (see docker-compose.yml) so the database survives `compose down/up`
# and image rebuilds — it is the entire persistence layer for Sieve; there is
# no separate Postgres/Qdrant/Meilisearch container to fall back on. Backup
# is `sqlite3 $SQLITE_PATH "VACUUM INTO '...'"`, nothing fancier.
SQLITE_PATH=./data/sieve.db


# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# Signing/encryption secret for Auth.js session cookies and JWTs. Generate a
# real one with:
#   openssl rand -base64 32
# Rotating this invalidates every existing session — on a single-user system
# that just means signing in again, so don't be precious about rotating it if
# you ever suspect it leaked. Never reuse a secret across environments
# (dev/prod need their own).
AUTH_SECRET=

# Credentials for the one seeded user. Consumed once by `pnpm seed:user`,
# which is idempotent (re-running with unchanged values is a no-op; changing
# SEED_USER_PASSWORD and re-running rotates the password). Sieve seeds
# exactly one account by design — see docs/adr/ for why multi-tenancy isn't
# built, and note that `user_id` is still on every row so adding a real
# signup flow later is additive, not a rewrite.
SEED_USER_EMAIL=you@example.com

# Plaintext here only because this file is the local seed input — the seed
# script hashes it with argon2 before it ever reaches the database, and it is
# never logged or stored in plaintext anywhere. Pick a real, unique password;
# your `.env` is the only place it's written down.
SEED_USER_PASSWORD=

# Shared secret the browser extension and the Android PWA share target send
# as `Authorization: Bearer <this value>` — see docs/API.md §1.2. It is valid
# on ONE endpoint only, POST /api/v1/capture: a leaked token lets someone add
# items to your library, never read, search, delete, or chat against it.
# Generate a long random value:
#   openssl rand -hex 32
# ...and paste it into the extension's options page (stored in
# chrome.storage.sync) after installing it. Treat it like a password.
EXTENSION_TOKEN=


# -----------------------------------------------------------------------------
# GitHub extraction
# -----------------------------------------------------------------------------

# Personal access token used by the GitHub extractor (repo description,
# language, stars, license, last-commit date, README) via the REST API.
#
# Create one at: https://github.com/settings/tokens
#   - Classic token: `public_repo` scope ONLY (read-only access to public
#     repos — do not grant more than that; Sieve never needs to write to a
#     repo or read private ones).
#   - Fine-grained token: works too, scope it to public repositories,
#     read-only, no other permissions.
#
# Why it matters: unauthenticated GitHub API requests are capped at 60/hr per
# IP; an authenticated PAT raises that to 5,000/hr. Without this set, GitHub
# items still capture (they just fall back toward `metadata_only` once the
# hourly ceiling is hit) — see docs/API.md §1.8 on extraction_tier.
GITHUB_PAT=


# -----------------------------------------------------------------------------
# LLM — OpenRouter (free tier only — read this whole block before changing
# LLM_DAILY_CAP or LLM_INTERACTIVE_RESERVE)
# -----------------------------------------------------------------------------
#
# *** THE ACCOUNT-WIDE FREE-TIER BUDGET ***
#
# OpenRouter's free tier is 1,000 requests/day AND 20 requests/minute,
# ACCOUNT-WIDE ACROSS EVERY `:free` MODEL COMBINED — not per model, not per
# API key. Calling five different `:free` models once each still spends 5 of
# the same 1,000. The counter resets at UTC midnight. Extra API keys do not
# give you a second counter — they share the same account-wide budget.
#
# The practical consequence: MODEL ROTATION BUYS AVAILABILITY, NOT CAPACITY.
# Listing several models in LLM_CHAIN_ENRICH/LLM_CHAIN_CHAT below means "if
# this one 429s, is deprecated, or is returning 503s, try the next one" — it
# does NOT mean "5 models = 5,000 requests/day." Any design that leans on
# rotation for extra throughput will quietly run out of budget the moment
# real usage picks up. Sieve's actual throughput comes from spending FEWER
# requests per item (one enrichment call, zero-request local embeddings,
# batched relation-labeling — see CLAUDE.md's "Free-Tier Budget" section),
# not from having more models to round-robin through.
#
# LLM_DAILY_CAP is Sieve's own soft ceiling, set BELOW the hard 1,000/day
# limit on purpose — it's a real, enforced budget (persisted in the
# `settings` table, checked before every LLM call), not a suggestion:
#   - Default 900 leaves 100 requests/day of headroom against the hard 1,000
#     (clock skew with OpenRouter's UTC reset, an off-by-one in the
#     day-boundary check, a burst that lands right at the line — this margin
#     is what keeps those from turning into a hard failure).
#   - LLM_INTERACTIVE_RESERVE carves out the LAST 100 of that 900
#     specifically for interactive work — chat (POST /api/v1/chat) and manual
#     re-enrich/retry — so a big background backfill (e.g. importing an
#     800-link WhatsApp export, P12.5) can never consume the requests you'd
#     want for asking your own library a question RIGHT NOW.
#     Concretely: background/batch pipeline stages stop pulling from the
#     budget once used_today reaches (LLM_DAILY_CAP - LLM_INTERACTIVE_RESERVE)
#     = 800; interactive requests keep working until used_today reaches the
#     full LLM_DAILY_CAP = 900.
#   - At the cap, LLM-dependent pipeline stages (enrich, relate) PAUSE —
#     jobs stay queued and resume automatically at 00:00 UTC. This is not an
#     error state: capture, extraction, chunking, local embedding, FTS
#     indexing, and hybrid search all keep working at zero LLM budget. Only
#     summaries/tags/topics land late. See GET /api/v1/health's `llm_quota`
#     block (docs/API.md §3.11) for how this is surfaced at runtime.
#   - The 20-requests/minute half of the limit is handled internally by a
#     token-bucket paced at ~18/min — there's no env var for it, since unlike
#     the daily cap there's no real reason to want a different pace than
#     "just under the platform's own ceiling."
#
# Get your key at: https://openrouter.ai/keys
# (Note: buying even $10 of OpenRouter credit once — never spending it — is
# what raises your account's free-tier ceiling from 50/day to 1,000/day. See
# the plan §5 for why Sieve's $15 balance is expected to sit untouched
# forever.)
OPENROUTER_API_KEY=

# Ordered model chain for enrichment (one structured-output call per item:
# tldr + bullets + tags + topic + repo fields, together — never split into
# multiple calls). Tried in order; a 429/404/5xx on one model falls through
# to the next. Every model here must support native structured output or a
# forced tool-call schema (P3.1.2's capability probe figures out which per
# model) — enrichment's reliability depends on the model actually returning
# valid, schema-conformant JSON, not on free-form prose.
#
# NEVER hardcode a model id in application code — free models get deprecated
# or renamed without warning; this env var is the only place these ids live,
# by design (see CLAUDE.md's non-negotiables).
LLM_CHAIN_ENRICH=nvidia/nemotron-3-super-120b-a12b:free,dots-studio/dots-3-note-preview:free,nex-agi/nex-n2.5-pro:free,openrouter/free,google/gemma-4-31b-it:free,nex-agi/nex-n2.5-mini:free

# Ordered model chain for chat/RAG and any oversized content that overflows
# the enrichment chain's context window (P3.1.1b's long-content router).
# These favor reasoning depth and huge context (up to 1M+ tokens) over strict
# schema support, since chat answers are free-form text with inline
# citations, not a JSON object.
LLM_CHAIN_CHAT=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free,nvidia/nemotron-3.5-lightning:free,thinkingmachines/inkling-small:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3-super-120b-a12b:free

# Hard daily ceiling on OpenRouter requests, shared across BOTH chains above
# plus relation-labeling. See the big comment block above before changing
# this — it is deliberately below OpenRouter's real 1,000/day account limit.
LLM_DAILY_CAP=900

# How many of LLM_DAILY_CAP's requests stay reserved for interactive use
# (chat, manual re-enrich/retry) so background jobs can't spend them first.
# See the big comment block above for the exact arithmetic.
LLM_INTERACTIVE_RESERVE=100


# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------

# Which EmbeddingProvider implementation to use. `local` (default) runs
# bge-small-en-v1.5 on-box via fastembed/onnxruntime-node — 384 dimensions,
# ~120 MB RAM, ZERO OpenRouter requests per embedding, which is what makes
# search and as-you-type querying free and instant. `openrouter` is the
# alternative implementation behind the same interface
# (nvidia/nemotron-3-embed-1b:free) — it trades that ~120 MB of RAM for
# spending free-tier request quota on every embed AND every search query, so
# it's not the default and switching to it is a deliberate choice, not a
# drop-in toggle.
#
# NEVER mix embedding models within one index — vectors from different
# models aren't comparable, and changing this value on a database that
# already has embedded chunks requires re-embedding everything with
# `pnpm reembed`, never a silent fallback. A startup guard refuses to write a
# chunk whose embedding_model doesn't match this setting.
EMBEDDING_PROVIDER=local


# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------

# Whether the in-process job worker loop (instrumentation.ts, concurrency 2:
# resolve -> extract -> enrich -> embed -> relate -> index) runs inside this
# same process. Default true — Sieve is one container by design (see the
# plan §3/§7 and docs/adr/). Set to false only if you've split the worker
# into its own container/process and don't want two loops claiming the same
# jobs table; this is the documented escape hatch if local embedding (the
# one CPU-bound stage) ever turns out to starve request handling on the VPS's
# shared 6 vCPUs, not something to flip casually.
WORKER_ENABLED=true
